	// Blink red LED
}


void display_USB_state() {
	if (g_usb.current == g_usb.previous) {
		return;
	}
	char msg[64];
	snprintf(msg, sizeof(msg), "USB State: %s", USB_GetStateString());
	HMI_addSystemMessage(msg);
	// update previous
	g_usb.previous = g_usb.current;
}


