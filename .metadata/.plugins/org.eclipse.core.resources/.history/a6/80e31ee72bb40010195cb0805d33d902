#include "usb_task.h"
#include "usbd_cdc_if.h"
#include "cmsis_os.h"
#include "main.h"

USB_Context_t g_usb = { USB_STATE_INIT, USB_STATE_INIT, 0 };

static void USB_HandleConfigured(void);
static void USB_HandleRx(void);
static void USB_HandleError(void);

void USB_Task(void *argument)
{
    const TickType_t delayMs = 10;
    uint8_t txBuf[64];
    uint32_t tick = 0;

    for (;;) {
        tick = osKernelGetTickCount();

        switch (g_usb.current)
        {
        case USB_STATE_INIT:
            if (hUsbDeviceHS.dev_state == USBD_STATE_CONFIGURED)
                g_usb.current = USB_STATE_CONFIGURED;
            break;

        case USB_STATE_CONFIGURED:
            // Example: send heartbeat every second
            if (tick - g_usb.lastTick >= 1000) {
                g_usb.lastTick = tick;
                snprintf((char*)txBuf, sizeof(txBuf), "JOY %04d %04d\r\n", 0, 0);
                if (CDC_Transmit_HS(txBuf, strlen((char*)txBuf)) == USBD_OK)
                    g_usb.current = USB_STATE_TX;
                else
                    g_usb.current = USB_STATE_ERROR;
            }
            break;

        case USB_STATE_TX:
            // Wait until TX is done (TX complete callback can reset it)
            if (hUsbDeviceHS.dev_state != USBD_STATE_CONFIGURED)
                g_usb.current = USB_STATE_ERROR;
            else
                g_usb.current = USB_STATE_CONFIGURED;
            break;

        case USB_STATE_RX:
            USB_HandleRx();
            g_usb.current = USB_STATE_CONFIGURED;
            break;

        case USB_STATE_ERROR:
            USB_HandleError();
            if (hUsbDeviceHS.dev_state == USBD_STATE_CONFIGURED)
                g_usb.current = USB_STATE_CONFIGURED;
            else
                g_usb.current = USB_STATE_INIT;
            break;

        default:
            g_usb.current = USB_STATE_INIT;
            break;
        }

        osDelay(delayMs);
    }
}




