static inline int8_t speed_to_level(int32_t d) {
	if (d > 0) {
		if (d < SPEED_THR0) return 0;
		if (d < SPEED_THR1) return 1;
		if (d < SPEED_THR2) return 2;
		else return 3;
	}
	else {
		if (d > (-1 * SPEED_THR0)) return 0;
		if (d > (-1 * SPEED_THR1)) return -1;
		if (d > (-1 * SPEED_THR2)) return -2;
		else return -3;
	}
}

static inline void display_motor_level(int8_t n) {
	// Reset all LEDs
	HAL_GPIO_WritePin(LED1_R_GPIO_Port, LED1_R_Pin, GPIO_PIN_RESET);
	HAL_GPIO_WritePin(LED2_R_GPIO_Port, LED2_R_Pin, GPIO_PIN_RESET);
	HAL_GPIO_WritePin(LED3_R_GPIO_Port, LED3_R_Pin, GPIO_PIN_RESET);
	HAL_GPIO_WritePin(LED1_G_GPIO_Port, LED1_G_Pin, GPIO_PIN_RESET);
	HAL_GPIO_WritePin(LED2_G_GPIO_Port, LED2_G_Pin, GPIO_PIN_RESET);
	HAL_GPIO_WritePin(LED3_G_GPIO_Port, LED3_G_Pin, GPIO_PIN_RESET);

	// Set LEDs based on speed
	if (n > 0) { // Clockwise - Green LEDs
		if (n >= 1) HAL_GPIO_WritePin(LED1_G_GPIO_Port, LED1_G_Pin, GPIO_PIN_SET);
		if (n >= 2) HAL_GPIO_WritePin(LED2_G_GPIO_Port, LED2_G_Pin, GPIO_PIN_SET);
		if (n >= 3) HAL_GPIO_WritePin(LED3_G_GPIO_Port, LED3_G_Pin, GPIO_PIN_SET);
	}
	else { // Counter-Clockwise - Red LEDs
		if (n <= 1) HAL_GPIO_WritePin(LED1_R_GPIO_Port, LED1_R_Pin, GPIO_PIN_SET);
		if (n <= 2) HAL_GPIO_WritePin(LED2_R_GPIO_Port, LED2_R_Pin, GPIO_PIN_SET);
		if (n <= 3) HAL_GPIO_WritePin(LED3_R_GPIO_Port, LED3_R_Pin, GPIO_PIN_SET);
	}
}
