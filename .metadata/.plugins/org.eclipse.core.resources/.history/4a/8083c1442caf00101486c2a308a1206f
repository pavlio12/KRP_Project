void led_thread_entry(ULONG init)
{
	// init
	if (tx_event_flags_create(&eventFlags, "button_flags") != TX_SUCCESS) {
			printf("Error when creating event flags for buttons\n");
		}

	if (encoder_driver_initialize() != TX_SUCCESS) {
		Error_Handler();
	}

	// Sampling loop
	uint32_t pos = 0, prev = 0;
	encoder_driver_input(&prev);

	while(1)
	{
		// Check button SW1

		if (tx_event_flags_get(&eventFlags, (EF_SW1), TX_AND_CLEAR, &flags, TX_NO_WAIT) == TX_SUCCESS) {
			encoder_driver_output(0);
			prev = 0;
		}
		int32_t d = (pos - prev);
		int8_t level = speed_to_level(d);
		display_motor_level(level);

		tx_thread_sleep(20);
	}
}

